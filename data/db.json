  "announcements": [
    {
      "id": 1,
      "title": "Thông báo kế hoạch đăng ký học phần học kỳ 1 năm học 2026–2027",
      "summary": "Sinh viên kiểm tra môn tiên quyết và đăng ký lớp học phần trong thời gian học kỳ demo.",
      "content": "Cổng đăng ký học phần của dữ liệu demo mở từ 01/09/2026 đến 10/01/2027. Sinh viên cần kiểm tra chương trình đào tạo, môn tiên quyết và tình trạng lớp học phần trước khi xác nhận đăng ký.",
      "publishedAt": "2026-09-01",
      "audience": "all"
    },
    {
      "id": 2,
      "title": "Hướng dẫn theo dõi điểm danh và điều kiện dự thi",
      "summary": "Tỷ lệ vắng được tổng hợp theo từng lớp học phần và đối chiếu ngưỡng vắng tối đa của môn học.",
      "content": "Sinh viên theo dõi lịch sử điểm danh trên hệ thống. Khi tỷ lệ vắng vượt ngưỡng tối đa của môn học, hệ thống hiển thị cảnh báo không đủ điều kiện dự thi để sinh viên chủ động trao đổi với giảng viên và Phòng Đào tạo.",
      "publishedAt": "2026-09-10",
      "audience": "student"
    },
    {
      "id": 3,
      "title": "Tra cứu chương trình đào tạo áp dụng từ năm 2026",
      "summary": "Danh sách chương trình đào tạo, môn học và số tín chỉ được công khai trên cổng thông tin.",
      "content": "Khách và sinh viên có thể tra cứu chương trình đào tạo đang áp dụng theo từng ngành. Danh sách môn học hiển thị mã môn, tên môn và số tín chỉ để phục vụ tham khảo kế hoạch học tập.",
      "publishedAt": "2026-09-15",
      "audience": "all"
    },
    {
      "id": 4,
      "title": "Nhắc hoàn thành điểm thành phần và điểm thi học kỳ 1",
      "summary": "Giảng viên kiểm tra danh sách lớp học phần và hoàn thành KT1, KT2, KT3, điểm thi trước khi khóa sổ điểm.",
      "content": "Giảng viên phụ trách lớp học phần cần rà soát danh sách sinh viên, chuyên cần và các thành phần KT1, KT2, KT3, điểm thi. Hệ thống tự tính điểm tổng kết và xếp loại sau khi lưu đủ các thành phần.",
      "publishedAt": "2026-09-20",
      "audience": "lecturer"
    }
  ]
}
